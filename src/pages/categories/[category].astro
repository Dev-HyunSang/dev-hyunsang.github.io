---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Rows from '../../components/Rows.astro';
import { postRow } from '../../lib/rows';
import { urlize } from '../../lib/slug';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const byCategory = new Map<string, { name: string; posts: typeof posts }>();
  for (const post of posts) {
    for (const c of post.data.categories ?? []) {
      const slug = urlize(c);
      if (!byCategory.has(slug)) byCategory.set(slug, { name: c, posts: [] });
      byCategory.get(slug)!.posts.push(post);
    }
  }
  return [...byCategory.entries()].map(([slug, { name, posts: categoryPosts }]) => ({
    params: { category: slug },
    props: { category: name, posts: categoryPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()) },
  }));
}

const { category, posts } = Astro.props;
---

<BaseLayout title={category}>
    <div class="list-page">
        <h1>{category}</h1>
        <p class="page-description">{posts.length}개의 포스트</p>

        <Rows rows={posts.map((post) => postRow(post))} />
    </div>
</BaseLayout>
