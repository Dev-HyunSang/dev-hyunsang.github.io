---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Rows from "../components/Rows.astro";
import { postRow } from "../lib/rows";
import { urlize } from "../lib/slug";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const categoryCounts = new Map<string, number>();
for (const post of posts) {
  for (const c of post.data.categories ?? []) {
    categoryCounts.set(c, (categoryCounts.get(c) ?? 0) + 1);
  }
}
---

<BaseLayout isHome={true}>
  <Rows rows={posts.map((post) => postRow(post))} />

  <p class="more"><a href="/posts/">더 다양한 글 보러가기 →</a></p>

  <!-- Category Filter (TOC-style sidebar) -->
  <aside class="toc-sidebar category-sidebar">
    <div class="toc-wrapper">
      <nav class="toc-nav">
        <ul>
          <li><p class="category-title">Categories</p></li>
          <li><a href="#" data-cat="" class="active">전체</a></li>
          {
            [...categoryCounts.entries()].map(([name, count]) => (
              <li>
                <a href="#" data-cat={urlize(name)}>
                  {name} ({count})
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </aside>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
      const links = document.querySelectorAll(".category-sidebar a[data-cat]");
      const posts = document.querySelectorAll(".rows li");
      if (!links.length) return;
      links.forEach((link) =>
        link.addEventListener("click", function (e) {
          e.preventDefault();
          const cat = this.dataset.cat;
          posts.forEach((p) => {
            const cats = (p.dataset.categories || "").trim().split(" ");
            p.style.display = !cat || cats.includes(cat) ? "" : "none";
          });
          links.forEach((l) => l.classList.toggle("active", l === this));
        }),
      );
    });
  </script>
</BaseLayout>
