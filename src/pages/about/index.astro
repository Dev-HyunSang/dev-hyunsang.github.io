---
import SingleLayout from "../../layouts/SingleLayout.astro";
import { Content, frontmatter } from "../../data/about/index.md";
---

<SingleLayout
  title={frontmatter.title}
  showDate={frontmatter.showDate}
  showAuthor={frontmatter.showAuthor}
  toc={frontmatter.toc}
>
  <Content />
</SingleLayout>

<style is:global>
  /* 프로필 사진 (본문 첫 이미지) */
  .post-body > p:first-child img {
    width: 300px;
  }
</style>
