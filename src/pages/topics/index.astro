---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Rows from '../../components/Rows.astro';
import { urlize } from '../../lib/slug';

const posts = await getCollection('posts', ({ data }) => !data.draft);

const categoryCounts = new Map<string, number>();
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const c of post.data.categories ?? []) categoryCounts.set(c, (categoryCounts.get(c) ?? 0) + 1);
  for (const t of post.data.tags ?? []) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
}
const categories = [...categoryCounts.entries()].sort((a, b) => b[1] - a[1]);
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Topics">
    <div class="list-page">
        <h1>Topics</h1>

        {categories.length > 0 && (
            <section>
                <h2 class="rows-title">Categories</h2>
                <Rows rows={categories.map(([name, count]) => ({
                    href: `/categories/${urlize(name)}/`,
                    label: `${count}개`,
                    title: name,
                }))} />
            </section>
        )}

        {tags.length > 0 && (
            <section>
                <h2 class="rows-title">Tags</h2>
                <Rows rows={tags.map(([name, count]) => ({
                    href: `/tags/${urlize(name)}/`,
                    label: `${count}개`,
                    title: `#${name}`,
                }))} />
            </section>
        )}
    </div>
</BaseLayout>
