---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Rows from '../../components/Rows.astro';
import { formatDateDot } from '../../lib/date';

const highlights = (await getCollection('highlights'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="밑줄 친 문장들 📚">
    <div class="list-page">
        <h1>밑줄 친 문장들 📚</h1>
        <p class="page-description">문학과 철학을 애증하고 있습니다. 한 해 동안 다양한 서적들을 읽고 밑줄 친 문장들을 남깁니다.</p>

        <Rows rows={highlights.map((entry) => ({
            href: `/highlights/${entry.id}/`,
            label: entry.data.showDate !== false ? formatDateDot(entry.data.date) : undefined,
            title: entry.data.title,
        }))} />
    </div>
</BaseLayout>
